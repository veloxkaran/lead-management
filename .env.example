APP_NAME="BizDev Manager"
APP_ENV=local
APP_KEY=base64:vIUZSXOAL5RLyKg/fdPOUvu0qSLHGjWqlaCfMFE9MuE=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Used only by ProductionAdminSeeder to create the initial Super Admin.
# Leave ADMIN_PASSWORD unset to have a random one generated and printed once.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Campaigns (Campaigns section; sender, signature, sending speed and gateway
# keys live in Administration -> Campaign Setup — these are only defaults).
# APP_URL above must be this app's public address for email open tracking and
# SMS delivery reports to reach it. Port 465 = SSL (smtps), 587 = STARTTLS.
CAMPAIGN_BATCH_SIZE=100
CAMPAIGN_EMAILS_PER_MINUTE=20
CAMPAIGN_BATCH_PAUSE_MINUTES=15
CAMPAIGN_SMS_PER_MINUTE=60
SMS_DEFAULT_COUNTRY_CODE=977

# The login campaign email is sent through (shown read-only in Campaign
# Setup). Leave CAMPAIGN_MAIL_HOST empty to fall back to the MAIL_* settings.
CAMPAIGN_MAIL_HOST=
CAMPAIGN_MAIL_PORT=465
CAMPAIGN_MAIL_USERNAME=
CAMPAIGN_MAIL_PASSWORD=
CAMPAIGN_MAIL_ENCRYPTION=ssl
CAMPAIGN_MAIL_FROM_ADDRESS=
CAMPAIGN_MAIL_FROM_NAME="${APP_NAME}"
CAMPAIGN_MAIL_REPLY_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
